{% comment %} Routes by page handle — pages need no template assignment in admin. {% endcomment %}
{% case page.handle %}
  {% when 'contact-us' %}{% render 'page-contact-us' %}
  {% when 'event-book-club-petersham' %}{% render 'page-event-book-club-petersham' %}
  {% when 'event-morena-self-love' %}{% render 'page-event-morena-self-love' %}
  {% when 'event-mortimer-house' %}{% render 'page-event-mortimer-house' %}
  {% when 'event-the-nest' %}{% render 'page-event-the-nest' %}
  {% when 'event-watercolour-regents-park' %}{% render 'page-event-watercolour-regents-park' %}
  {% when 'events' %}{% render 'page-events' %}
  {% when 'guest-list' %}{% render 'page-guest-list' %}
  {% when 'pilates-with-cristina' %}{% render 'page-pilates-with-cristina' %}
  {% when 'story' %}{% render 'page-story' %}
  {% when 'terms-and-conditions' %}{% render 'page-terms-and-conditions' %}
  {% else %}
{% comment %}
  Fallback for every page the redesign did not port — about, faq, yoga-mat-rentals, my-story and
  ~25 more that are still live and still in the sitemap. This used to render a bare <h1> and the
  page body with no header and no footer, which left them orphaned: a crawler (or a visitor
  landing from search) had no link back into the site at all. Wrapping them in the same chrome the
  blog uses restores the nav, the footer and the internal links, with no change to the pages that
  ARE ported above.
{% endcomment %}
{% render 'blog-chrome-head' %}
<main>
  <section class="bhead">
    <h1>{{ page.title }}</h1>
  </section>
  <div class="bwrap">
    <div class="article-body">{{ page.content }}</div>
  </div>
</main>
{% render 'blog-chrome-foot' %}
{% endcase %}
