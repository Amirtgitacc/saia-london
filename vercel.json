{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "//": "chat-log.html shows transcripts carrying names, postcodes and emails. frame-ancestors/X-Frame-Options stop it being framed, connect-src pins its fetches to /api on this host. 'unsafe-inline' is unavoidable: the page's script and styles are inline.",
      "source": "/chat-log.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "//": "API responses are JSON, never markup — nosniff stops a browser guessing otherwise.",
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "https://www.saialondon.com/", "permanent": true },
    { "source": "/index.html", "destination": "https://www.saialondon.com/", "permanent": true },
    { "source": "/events.html", "destination": "https://www.saialondon.com/pages/events", "permanent": true },
    { "source": "/story.html", "destination": "https://www.saialondon.com/pages/story", "permanent": true },
    { "source": "/pilates-with-cristina.html", "destination": "https://www.saialondon.com/pages/pilates-with-cristina", "permanent": true },
    { "source": "/contact-us.html", "destination": "https://www.saialondon.com/pages/contact-us", "permanent": true },
    { "source": "/guest-list.html", "destination": "https://www.saialondon.com/pages/guest-list", "permanent": true },
    { "source": "/terms-and-conditions.html", "destination": "https://www.saialondon.com/pages/terms-and-conditions", "permanent": true },
    { "source": "/event-book-club-petersham.html", "destination": "https://www.saialondon.com/pages/event-book-club-petersham", "permanent": true },
    { "source": "/event-morena-self-love.html", "destination": "https://www.saialondon.com/pages/event-morena-self-love", "permanent": true },
    { "source": "/event-mortimer-house.html", "destination": "https://www.saialondon.com/pages/event-mortimer-house", "permanent": true },
    { "source": "/event-the-nest.html", "destination": "https://www.saialondon.com/pages/event-the-nest", "permanent": true },
    { "source": "/event-watercolour-regents-park.html", "destination": "https://www.saialondon.com/pages/event-watercolour-regents-park", "permanent": true },
    { "source": "/checkout.html", "destination": "https://www.saialondon.com/cart", "permanent": true },
    { "source": "/samples.html", "destination": "https://www.saialondon.com/", "permanent": true },
    { "source": "/sample-film.html", "destination": "https://www.saialondon.com/", "permanent": true },
    { "source": "/sample-hybrid.html", "destination": "https://www.saialondon.com/", "permanent": true }
  ]
}
